# Optional public URL for the Express meal-analysis endpoint.
# Leave empty when reviewing the UI. Complete the authentication and contract
# integration described in APP_INTEGRATION.md before enabling live analysis.
# Example endpoint: http://localhost:5001/api/analyze
VITE_MEAL_ANALYSIS_URL=

# Public OAuth Web application client ID (not a client secret).
# Enable Photos Picker API and register http://localhost:5173 as a JS origin.
VITE_GOOGLE_PHOTOS_CLIENT_ID=

# Express origin for Google Photos imports. Empty uses the current origin;
# Vite proxies /api/google-photos to localhost:5001 during development.
# Set the deployed backend HTTPS origin before a production build.
VITE_API_BASE_URL=
