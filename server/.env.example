# Express server configuration
PORT=5001
NODE_ENV=development

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# File upload limits
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=20

# Firebase Authentication
# Use the shared PlatePal Firebase project ID
FIREBASE_PROJECT_ID=


# BE-07: Python ADK service integration
# Set to the endpoint agreed upon with the ADK developer
ADK_SERVICE_URL=

# Maximum time to wait for an ADK response (milliseconds)
ADK_TIMEOUT_MS=120000
