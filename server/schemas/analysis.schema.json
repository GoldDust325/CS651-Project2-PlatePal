
{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PlatePal Shared Analysis Contract",
    "description": "Shared data contract for React, Express, ADK, and Firestore.",
    "oneOf": [
        { "$ref": "#/definitions/analysisRequest" },
        { "$ref": "#/definitions/analysisResponse" },
        { "$ref": "#/definitions/apiError" }
    ],
    "definitions": {
        "schemaVersion": {
            "type": "string",
            "const": "1.0.0"
        },
        "companionStyle": {
            "type": "string",
            "enum": ["casual", "strict", "athlete"]
        },
        "photo": {
            "type": "object",
            "required": ["source", "mimeType", "data"],
            "properties": {
                "source": {
                    "enum": ["local", "google_photos"]
                },
                "mimeType": {
                    "enum": [
                        "image/jpeg",
                        "image/png",
                        "image/webp"
                    ]
                },
                "data": {
                    "type": "string",
                    "minLength": 1,
                    "contentEncoding": "base64"
                }
            },
            "additionalProperties": false
        },
        "audio": {
            "type": "object",
            "required": ["mimeType", "data", "durationSeconds"],
            "properties": {
                "mimeType": {
                    "enum": [
                        "audio/mpeg",
                        "audio/mp4",
                        "audio/wav",
                        "audio/webm",
                        "audio/ogg",
                        "audio/x-wav"
                    ]
                },
                "data": {
                    "type": "string",
                    "minLength": 1,
                    "contentEncoding": "base64"
                },
                "durationSeconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 60
                }
            },
            "additionalProperties": false
        },
        "quantity": {
            "type": "object",
            "required": ["amount", "unit"],
            "properties": {
                "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "unit": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "estimatedMacros": {
            "type": "object",
            "required": [
                "calories",
                "proteinGrams",
                "carbohydrateGrams",
                "fatGrams"
            ],
            "properties": {
                "calories": {
                    "type": "number",
                    "minimum": 0
                },
                "proteinGrams": {
                    "type": "number",
                    "minimum": 0
                },
                "carbohydrateGrams": {
                    "type": "number",
                    "minimum": 0
                },
                "fatGrams": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "foodCategory": {
            "type": "string",
            "enum": [
                "protein",
                "grain",
                "vegetable",
                "fruit",
                "dairy",
                "fat_oil",
                "sweet",
                "beverage",
                "mixed",
                "other"
            ]
        },
        "estimatedNutrients": {
            "type": "object",
            "required": ["fiberGrams", "sugarGrams", "sodiumMilligrams"],
            "properties": {
                "fiberGrams": {
                    "type": "number",
                    "minimum": 0
                },
                "sugarGrams": {
                    "type": "number",
                    "minimum": 0
                },
                "sodiumMilligrams": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "food": {
            "type": "object",
            "required": [
                "foodId",
                "name",
                "quantity",
                "estimatedMacros",
                "corrected"
            ],
            "properties": {
                "foodId": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "quantity": {
                    "$ref": "#/definitions/quantity"
                },
                "estimatedMacros": {
                    "$ref": "#/definitions/estimatedMacros"
                },
                "category": {
                    "$ref": "#/definitions/foodCategory"
                },
                "estimatedNutrients": {
                    "$ref": "#/definitions/estimatedNutrients"
                },
                "corrected": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "conflict": {
            "type": "object",
            "required": [
                "conflictId",
                "foodId",
                "imageObservation",
                "audioAssertion",
                "resolved"
            ],
            "properties": {
                "conflictId": {
                    "type": "string",
                    "minLength": 1
                },
                "foodId": {
                    "type": "string",
                    "minLength": 1
                },
                "imageObservation": {
                    "type": "string",
                    "minLength": 1
                },
                "audioAssertion": {
                    "type": "string",
                    "minLength": 1
                },
                "resolved": {
                    "type": "boolean"
                },
                "resolution": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "if": {
                "properties": {
                    "resolved": { "const": true }
                }
            },
            "then": {
                "required": ["resolution"]
            },
            "additionalProperties": false
        },
        "correction": {
            "type": "object",
            "required": [
                "foodId",
                "previousName",
                "correctedName",
                "previousQuantity",
                "correctedQuantity"
            ],
            "properties": {
                "foodId": {
                    "type": "string",
                    "minLength": 1
                },
                "previousName": {
                    "type": "string",
                    "minLength": 1
                },
                "correctedName": {
                    "type": "string",
                    "minLength": 1
                },
                "previousQuantity": {
                    "$ref": "#/definitions/quantity"
                },
                "correctedQuantity": {
                    "$ref": "#/definitions/quantity"
                }
            },
            "additionalProperties": false
        },
        "dietaryContext": {
            "type": "object",
            "required": ["allergies", "cravings"],
            "properties": {
                "allergies": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "cravings": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "additionalProperties": false
        },
        "allergyFlag": {
            "type": "object",
            "required": ["allergen", "foodIds", "note"],
            "properties": {
                "allergen": {
                    "type": "string",
                    "minLength": 1
                },
                "foodIds": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "note": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "review": {
            "type": "object",
            "required": [
                "healthRating",
                "healthNote",
                "suggestedAdditions",
                "allergyFlags"
            ],
            "properties": {
                "healthRating": {
                    "enum": ["balanced", "okay", "needs_attention"]
                },
                "healthNote": {
                    "type": "string",
                    "minLength": 1
                },
                "suggestedAdditions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "allergyFlags": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/allergyFlag"
                    }
                },
                "cravingSuggestion": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "fitnessGoal": {
            "type": "string",
            "enum": [
                "lose_weight",
                "maintain",
                "build_muscle",
                "improve_performance",
                "eat_healthier"
            ]
        },
        "dailyTargets": {
            "type": "object",
            "required": [
                "calories",
                "proteinGrams",
                "carbohydrateGrams",
                "fatGrams",
                "fiberGrams"
            ],
            "properties": {
                "calories": {
                    "type": "number",
                    "minimum": 1000,
                    "maximum": 5000
                },
                "proteinGrams": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 400
                },
                "carbohydrateGrams": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 800
                },
                "fatGrams": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 300
                },
                "fiberGrams": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                }
            },
            "additionalProperties": false
        },
        "goals": {
            "type": "object",
            "required": ["fitnessGoal", "dailyTargets", "weeklyGoals"],
            "properties": {
                "fitnessGoal": {
                    "$ref": "#/definitions/fitnessGoal"
                },
                "dailyTargets": {
                    "$ref": "#/definitions/dailyTargets"
                },
                "weeklyGoals": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                    }
                }
            },
            "additionalProperties": false
        },
        "planUpdate": {
            "type": "object",
            "required": ["goals", "reason", "basedOnMealCount"],
            "properties": {
                "goals": {
                    "$ref": "#/definitions/goals"
                },
                "reason": {
                    "type": "string",
                    "minLength": 1
                },
                "basedOnMealCount": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "analysisRequest": {
            "type": "object",
            "required": [
                "schemaVersion",
                "photo",
                "companionStyle"
            ],
            "properties": {
                "schemaVersion": {
                    "$ref": "#/definitions/schemaVersion"
                },
                "photo": {
                    "$ref": "#/definitions/photo"
                },
                "audio": {
                    "$ref": "#/definitions/audio"
                },
                "companionStyle": {
                    "$ref": "#/definitions/companionStyle"
                }
            },
            "additionalProperties": false
        },
        "analysisResponse": {
            "type": "object",
            "required": [
                "schemaVersion",
                "analysisId",
                "createdAt",
                "foods",
                "imageEvidence",
                "audioAssertions",
                "conflicts",
                "uncertainties",
                "estimatedMacros",
                "macroStatus",
                "recommendation",
                "companionStyle",
                "reviewed",
                "corrected",
                "corrections"
            ],
            "properties": {
                "schemaVersion": {
                    "$ref": "#/definitions/schemaVersion"
                },
                "analysisId": {
                    "type": "string",
                    "minLength": 1
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "foods": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/food"
                    }
                },
                "imageEvidence": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "audioAssertions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "dietaryContext": {
                    "$ref": "#/definitions/dietaryContext"
                },
                "conflicts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/conflict"
                    }
                },
                "uncertainties": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "estimatedMacros": {
                    "$ref": "#/definitions/estimatedMacros"
                },
                "estimatedNutrients": {
                    "$ref": "#/definitions/estimatedNutrients"
                },
                "macroStatus": {
                    "enum": ["estimated", "pending_recalculation"]
                },
                "recommendation": {
                    "type": "string",
                    "minLength": 1
                },
                "review": {
                    "$ref": "#/definitions/review"
                },
                "planUpdate": {
                    "$ref": "#/definitions/planUpdate"
                },
                "companionStyle": {
                    "$ref": "#/definitions/companionStyle"
                },
                "reviewed": {
                    "type": "boolean"
                },
                "corrected": {
                    "type": "boolean"
                },
                "corrections": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/correction"
                    }
                }
            },
            "additionalProperties": false
        },
        "apiError": {
            "type": "object",
            "required": ["error"],
            "properties": {
                "schemaVersion": {
                    "$ref": "#/definitions/schemaVersion"
                },
                "error": {
                    "type": "object",
                    "required": ["code", "message"],
                    "properties": {
                        "code": {
                            "type": "string",
                            "minLength": 1
                        },
                        "message": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    }
}
